{
  "require": {
    "php": ">=8.3",
    "ext-fileinfo": "*",
    "ext-openssl": "*",
    "phpmailer/phpmailer": "^6.10"
  },
  "autoload": {
    "psr-4": {
      "App\\Controller\\": "src/controllers/",
      "App\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
