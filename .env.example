# Wzór pliku .env. Skopiuj go (cp .env.example .env) i w razie potrzeby zmień wartości.
# Wartości poniżej to te same domyślne, których docker-compose.yaml używa bez pliku .env,


POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password

POSTGRES_PORT=5433

MAILPIT_PORT=8025

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
