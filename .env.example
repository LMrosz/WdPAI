# Wzór pliku .env. Skopiuj go (cp .env.example .env) i w razie potrzeby zmień wartości.
# Wartości poniżej to te same domyślne, których docker-compose.yaml używa bez pliku .env,


POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password

POSTGRES_PORT=5433

# Poczta (Lab 13). Lokalnie wiadomości przechwytuje Mailpit: panel na http://localhost:8025,
# SMTP dla aplikacji pod nazwą usługi mailpit i portem 1025 (bez logowania i szyfrowania).
MAILPIT_PORT=8025
MAIL_HOST=mailpit
MAIL_PORT=1025
# na prawdziwym serwerze SMTP: MAIL_USERNAME, MAIL_PASSWORD i MAIL_ENCRYPTION (tls = STARTTLS, ssl = SMTPS)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM=noreply@corvobianco.local
MAIL_FROM_NAME=Corvo Bianco
# adres aplikacji w linkach z e-maili (bez końcowego ukośnika)
APP_URL=https://localhost:8443

# HTTPS (Lab 12): 1 = port 8080 przekierowuje na https://localhost:8443 (certyfikat samopodpisany),
# 0 = praca przez zwykłe http://localhost:8080 bez certyfikatu
FORCE_HTTPS=1
HTTPS_PORT=8443

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
